{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Upload current file to Pico as main.py",
      "type": "process",
      "command": "python",
      "args": ["-m", "mpremote", "connect", "auto", "fs", "cp", "${file}", ":main.py", "+", "reset"],
      "problemMatcher": []
    },
    {
      "label": "Run current file on Pico (no save)",
      "type": "process",
      "command": "python",
      "args": ["-m", "mpremote", "connect", "auto", "run", "${file}"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
